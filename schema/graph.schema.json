{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CiaranWelsh/knowledge-graph/schema/graph.schema.json",
  "title": "Knowledge Graph",
  "description": "A directed acyclic graph of nodes with prerequisites and per-node status tracking. Supports custom status schemes.",
  "type": "object",
  "required": ["name", "nodes"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable name for this graph."
    },
    "description": {
      "type": "string",
      "description": "What this graph is for."
    },
    "statuses": {
      "type": "array",
      "description": "Custom status scheme. If omitted, defaults are used: untested, weak, developing, solid, mastered. Array order determines display order in the viewer. The first entry is the default status for new nodes.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/status"
      }
    },
    "dimensions": {
      "type": "array",
      "description": "Custom categorical dimensions for classifying nodes. Each dimension defines a set of named values with colours. The viewer can switch between colouring by status or by any dimension.",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "nodes": {
      "type": "object",
      "description": "Map of node ID to node object. IDs should be kebab-case.",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "object",
      "description": "A status definition with ID, display label, and colour.",
      "required": ["id", "label", "color"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier used in node status fields.",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "description": "Human-readable display label."
        },
        "color": {
          "type": "string",
          "description": "Hex colour for node background in the viewer.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "dimension": {
      "type": "object",
      "description": "A categorical dimension for classifying nodes (e.g. language, domain, phase).",
      "required": ["id", "label", "values"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this dimension.",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "description": "Human-readable display label."
        },
        "values": {
          "type": "array",
          "description": "The possible values for this dimension.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dimensionValue"
          }
        }
      }
    },
    "dimensionValue": {
      "type": "object",
      "description": "A value within a dimension.",
      "required": ["id", "label", "color"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier within this dimension.",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "description": "Human-readable display label."
        },
        "color": {
          "type": "string",
          "description": "Hex colour for this value.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "node": {
      "type": "object",
      "description": "A node in the graph representing a skill, concept, or topic.",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable display name."
        },
        "description": {
          "type": "string",
          "description": "What this node represents."
        },
        "prerequisites": {
          "type": "array",
          "description": "Node IDs that must come before this one. Must reference existing node keys. No cycles allowed.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "status": {
          "type": "string",
          "description": "Current status. Must be one of the defined status IDs (custom or default). Defaults to the first status in the scheme."
        },
        "last_tested": {
          "type": ["string", "null"],
          "description": "ISO 8601 date of last assessment.",
          "format": "date"
        },
        "exercise_series": {
          "type": ["string", "null"],
          "description": "Path to associated exercise series directory or file."
        },
        "dimensions": {
          "type": "object",
          "description": "Dimension values for this node. Keys are dimension IDs, values are value IDs within that dimension.",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        },
        "shape": {
          "type": "string",
          "description": "Cytoscape.js node shape. Defaults to round-rectangle.",
          "enum": [
            "ellipse",
            "triangle",
            "round-triangle",
            "rectangle",
            "round-rectangle",
            "bottom-round-rectangle",
            "cut-rectangle",
            "barrel",
            "rhomboid",
            "diamond",
            "round-diamond",
            "pentagon",
            "round-pentagon",
            "hexagon",
            "round-hexagon",
            "concave-hexagon",
            "heptagon",
            "round-heptagon",
            "octagon",
            "round-octagon",
            "star",
            "tag",
            "round-tag",
            "vee"
          ],
          "default": "round-rectangle"
        },
        "position": {
          "type": "object",
          "description": "Saved viewer position for this node.",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      }
    }
  }
}